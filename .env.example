# 必填。至少 12 个字符，包含大小写字母、数字和符号，最多 72 个 UTF-8 字节。
ASSISTANT_PASSWORD=
# 升级期间临时兼容旧口令。更换口令后设回 false。
ASSISTANT_ALLOW_LEGACY_PASSWORD=false
ASSISTANT_SESSION_TIMEOUT=4h
# 可选。登录用户名。
ASSISTANT_OWNER=learner
# 端口和 Cookie。仅限本机 HTTP 时用 false，经 HTTPS 访问时改为 true。
ASSISTANT_PORT=8080
ASSISTANT_SECURE_COOKIE=false
# 可选。只列受信任的反向代理地址正则，以及确需跨域访问的精确来源。
# ASSISTANT_TRUSTED_PROXY_REGEX=127\.0\.0\.1|::1
ASSISTANT_CORS_ORIGINS=

# 资料目录，按启动方式选择对应变量。Compose 必须能读取已经存在的宿主机目录。
ASSISTANT_DOCUMENTS_DIR=./learning-materials
# 直接启动 JAR 时必填，示例 ASSISTANT_DOCUMENTS=D:/学习资料
ASSISTANT_DOCUMENTS=

# 数据库密码必填。Compose 内部的 JDBC 地址由服务定义覆盖。
ASSISTANT_DB_PASSWORD=
ASSISTANT_DB_USER=assistant
ASSISTANT_DB_URL=jdbc:postgresql://127.0.0.1:5432/assistant
ASSISTANT_DB_POOL_MAX=10
ASSISTANT_DB_POOL_MIN_IDLE=2

# 模型密钥必填。URL 填 OpenAI 兼容服务的根地址，两个模型名按实际服务填写。
ASSISTANT_MODEL_KEY=
ASSISTANT_MODEL_URL=https://api.openai.com
ASSISTANT_CHAT_MODEL=gpt-4o-mini
ASSISTANT_EMBEDDING_MODEL=text-embedding-3-small
# 提问和拟稿共享的新任务额度，每分钟。
ASSISTANT_AI_JOBS_PER_MINUTE=12
ASSISTANT_API_OWNER_PER_MINUTE=240
ASSISTANT_API_ANONYMOUS_PER_MINUTE=120
ASSISTANT_LOGIN_PER_MINUTE=10
# 查询向量的进程内缓存。设为 0 可关闭缓存。
ASSISTANT_EMBED_CACHE_ENTRIES=512
ASSISTANT_EMBED_CACHE_TTL=10m

# 邮件可选。以下主机、账号和凭据在启用对应收信或发信功能时填写。
# 例如 Gmail 接收主机 imap.gmail.com，账号填写完整邮箱。
ASSISTANT_IMAP_HOST=
ASSISTANT_IMAP_PORT=993
ASSISTANT_IMAP_TLS=true
ASSISTANT_IMAP_USER=
ASSISTANT_IMAP_PASSWORD=
# 可选。已发送文件夹的实际 IMAP 名称，供回执丢失后核对。
ASSISTANT_IMAP_SENT_FOLDER=
# 可选。默认由 IMAP 协商，使用外部 OAuth 令牌时填 XOAUTH2。
ASSISTANT_IMAP_AUTH_MECHANISMS=
# 例如 Gmail 发送主机 smtp.gmail.com。465 通常用隐式 TLS。
ASSISTANT_SMTP_HOST=
ASSISTANT_SMTP_PORT=465
ASSISTANT_SMTP_SSL=true
# 587 端口使用 STARTTLS 时，同时设置 SSL=false。
ASSISTANT_SMTP_STARTTLS=false
ASSISTANT_SMTP_AUTH=true
ASSISTANT_SMTP_AUTH_MECHANISMS="LOGIN PLAIN DIGEST-MD5 NTLM"
ASSISTANT_SMTP_USER=
ASSISTANT_SMTP_PASSWORD=
# 启用发信时必填。使用服务商授权的 From 地址。
ASSISTANT_MAIL_FROM=

# 可选。后台自动同步资料、收信及发送结果核对间隔，单位毫秒。
ASSISTANT_INDEX_MS=60000
ASSISTANT_MAIL_MS=60000
ASSISTANT_RECONCILE_MS=120000
# 默认输出 ECS JSON。ASSISTANT_LOG_FORMAT 留空时使用文本日志。
ASSISTANT_LOG_FORMAT=ecs
ASSISTANT_LOG_LEVEL=INFO
ASSISTANT_APP_LOG_LEVEL=INFO
# 可选。配置自有 OpenTelemetry Collector 后启用 OTLP 传输。
ASSISTANT_OTLP_ENABLED=false
ASSISTANT_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
ASSISTANT_TRACE_SAMPLE_RATE=0.1
